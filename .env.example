# Reference list of every variable PlayState uses.
# Each app reads its own file:
#   apps/web/.env.local  (template: apps/web/.env.example)
#   apps/api/.env        (template: apps/api/.env.example)

# --- apps/web ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/library
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/library
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- apps/api ---
PORT=4000
FRONTEND_URL=http://localhost:3000
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
DATABASE_URL=
DIRECT_URL=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
