# Copy to apps/api/.env and fill in real values. Never commit .env.

PORT=4000

# Origin(s) allowed to call this API from a browser. Comma-separated.
FRONTEND_URL=http://localhost:3000

# Clerk (Dashboard > Configure > API keys)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Signing secret of the Clerk webhook that reports deleted accounts
# (Dashboard > Configure > Webhooks). Endpoint: /api/webhooks/clerk, event: user.deleted
CLERK_WEBHOOK_SIGNING_SECRET=

# Supabase PostgreSQL (Dashboard > Connect > ORMs > Prisma)
# DATABASE_URL: transaction pooler, port 6543, used by the running API.
# DIRECT_URL: session pooler, port 5432, used by Prisma migrations.
DATABASE_URL=
DIRECT_URL=

# IGDB via Twitch (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Steam Web API key, used to import a Steam library (https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=
