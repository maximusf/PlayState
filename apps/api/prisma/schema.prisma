generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Shared game metadata, cached from IGDB the first time any user adds the game.
model Game {
  id              String    @id @default(cuid())
  igdbId          Int       @unique
  title           String
  coverUrl        String?
  releaseDate     DateTime?
  // IGDB's "normally" time to finish the game, in hours. Null when IGDB has none.
  timeToBeatHours Int?

  genres    String[]
  themes    String[]
  gameModes String[]

  userGames UserGame[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per game in a user's library. userId is the Clerk user ID.
model UserGame {
  id     String @id @default(cuid())
  userId String
  gameId String

  game  Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  picks Pick[]

  // How long this player's sittings with the game usually are. Null until they say.
  sessionLength SessionLength?

  createdAt DateTime @default(now())

  @@unique([userId, gameId])
  @@index([userId])
}

enum SessionLength {
  SHORT
  MEDIUM
  LONG
}

// One row each time a player presses "Choose this" on a suggestion.
// availableTime is the picker answer they gave, so later picks can learn from it.
model Pick {
  id         String @id @default(cuid())
  userId     String
  userGameId String

  userGame UserGame @relation(fields: [userGameId], references: [id], onDelete: Cascade)

  availableTime String

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userGameId])
}
