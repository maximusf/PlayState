generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Shared game metadata, cached from IGDB the first time any user adds the game.
model Game {
  id              String    @id @default(cuid())
  igdbId          Int       @unique
  title           String
  coverUrl        String?
  releaseDate     DateTime?
  // IGDB's "normally" time to finish the game, in hours. Null when IGDB has none.
  timeToBeatHours Int?

  genres    String[]
  themes    String[]
  gameModes String[]

  userGames UserGame[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per game in a user's library. userId is the Clerk user ID.
model UserGame {
  id     String @id @default(cuid())
  userId String
  gameId String

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  // How long this player's sittings with the game usually are. Null until they say.
  sessionLength SessionLength?

  createdAt DateTime @default(now())

  @@unique([userId, gameId])
  @@index([userId])
}

// A group of players comparing libraries. Anyone with the invite link can join.
model Party {
  id   String @id @default(cuid())
  // Unguessable code used in the invite link.
  code String @unique
  name String
  // Clerk user ID of the player who started the party. Only they can end it.
  hostId String
  // Clerk user IDs of players the host removed. They cannot rejoin with the link.
  removedUserIds String[] @default([])

  members PartyMember[]

  createdAt DateTime @default(now())

  @@index([hostId])
}

// One row per player in a party. userId is the Clerk user ID.
model PartyMember {
  id      String @id @default(cuid())
  partyId String
  userId  String
  // The name this player chose to go by in this party.
  displayName String

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([partyId, userId])
  @@index([userId])
}

enum SessionLength {
  SHORT
  MEDIUM
  LONG
}
