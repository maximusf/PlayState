generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Shared game metadata, cached from IGDB the first time any user adds the game.
model Game {
  id              String    @id @default(cuid())
  igdbId          Int       @unique
  title           String
  coverUrl        String?
  releaseDate     DateTime?
  // IGDB's "normally" time to finish the game, in hours. Null when IGDB has none.
  timeToBeatHours Int?

  genres    String[]
  themes    String[]
  gameModes String[]

  userGames UserGame[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per game in a user's library. userId is the Clerk user ID.
model UserGame {
  id     String @id @default(cuid())
  userId String
  gameId String

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  // How long this player's sittings with the game usually are. Null until they say.
  sessionLength SessionLength?

  // No longer set or shown. The column stays so removing the feature needs no migration.
  familyShared Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([userId, gameId])
  @@index([userId])
}

// A group of players comparing libraries. Anyone with the invite link can join.
model Party {
  id   String @id @default(cuid())
  // Unguessable code used in the invite link.
  code String @unique
  name String
  // Clerk user ID of the player who started the party. Only they can end it.
  hostId String
  // Clerk user IDs of players the host removed. They cannot rejoin with the link.
  removedUserIds String[] @default([])
  // The game the host's latest dice roll landed on, shown to every member.
  rolledIgdbId Int?
  rolledAt     DateTime?
  // Set by the host. When true, games too small for the group still count as playable.
  ignoreLimits Boolean   @default(false)
  // When the party is removed. The host picks the length at the start and it cannot be changed.
  expiresAt DateTime
  // No longer used, because parties cannot be extended. The column stays so no migration is needed.
  extended  Boolean  @default(false)
  // The picture behind the top of the party page, chosen by the host. Null means none.
  backdropId String?
  // How the host's dice roll is shown to the party. One of the ids in src/lib/party-roll-styles.ts.
  rollStyle String @default("classic")

  members     PartyMember[]
  messages    PartyMessage[]
  nominations PartyNomination[]
  reactions   PartyReaction[]

  createdAt DateTime @default(now())

  @@index([hostId])
  @@index([expiresAt])
}

// One row per player in a party. userId is the Clerk user ID.
model PartyMember {
  id      String @id @default(cuid())
  partyId String
  userId  String
  // The name this player chose to go by in this party.
  displayName String
  // The hat this player wears on their avatar. Null means no hat.
  hatId String?

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([partyId, userId])
  @@index([userId])
}

// One chat line in a party. Messages live only as long as the party, which deletes them with it.
model PartyMessage {
  id      String @id @default(cuid())
  partyId String
  // Clerk user ID of the sender. Never sent to other players.
  userId  String
  // The sender's nickname when they wrote it, so a later change does not rewrite history.
  displayName String
  body        String

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([partyId, createdAt])
}

// A short-lived emoji reaction sent by a party member. Rows are pruned as new ones arrive.
model PartyReaction {
  id      String @id @default(cuid())
  partyId String
  userId  String
  // An id from the reaction emoji manifest in the web app.
  emoji   String

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([partyId, createdAt])
}

// A game a member put forward for the next roll. Cleared when the host rolls.
model PartyNomination {
  id      String @id @default(cuid())
  partyId String
  // Clerk user ID of the member who nominated the game.
  userId  String
  igdbId  Int

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([partyId, userId, igdbId])
  @@index([partyId])
}

enum SessionLength {
  SHORT
  MEDIUM
  LONG
}
