# Copy to apps/web/.env.local and fill in real values. Never commit .env.local.

# Clerk (Dashboard > Configure > API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/library
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/library

# Base URL of the PlayState API
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public origin of the web app, used for absolute og:image and sitemap URLs.
# Set this in production (for example https://playstate.example.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
